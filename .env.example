# 项目配置
PROJECT_NAME=official
DOCKERHUB_USERNAME=boyuanclub
APP_PORT=8080

# 数据库配置
DB_ROOT_PASSWORD=root
DB_NAME=official
DB_USERNAME=root
DB_PASSWORD=root
# 与 docker-compose 宿主机映射一致（official-mysql 一般为 3307:3306）
MYSQL_PORT=3307

# Redis配置
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT配置
JWT_SECRET=)fFQ82L8dU]t3C?.HB^;x,xYm9Y<aK21<|K|o0D6(c!X}8[cUZ_l=&0Y('#/K}n_
JWT_EXPIRATION=86400000

# 邮件服务配置
MAIL_HOST=smtp.feishu.cn
MAIL_PORT=465
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password

# 短信服务配置
SMS_ACCESS_KEY=your-sms-access-key
SMS_SECRET_KEY=your-sms-secret-key
SMS_TEMPLATE_ID_VERIFICATION=your-sms-template-id
SMS_REGION_ID=your-sms-region-id

# 腾讯云 COS 对象存储（头像上传）
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_REGION=ap-shanghai
COS_BUCKET=your-bucket-1250000000
# 对外访问基地址（如 https://static.boyuan.club），留空则回退到后端 /api/files 中转
COS_PUBLIC_BASE_URL=
COS_AVATAR_PREFIX=avatars/

# 飞书开放平台（企业自建应用，勿使用个人账号密码）
# 在 https://open.feishu.cn 创建应用，开通「多维表格」读写权限，并发布到企业
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_PARALLEL_BUCKET_CONCURRENCY=3
FEISHU_API_MAX_RETRIES=3
FEISHU_API_INITIAL_BACKOFF_MS=500
FEISHU_API_MAX_BACKOFF_MS=8000
FEISHU_CIRCUIT_FAILURE_THRESHOLD=5
FEISHU_CIRCUIT_OPEN_SECONDS=30
FEISHU_TASK_TTL_DAYS=7
FEISHU_TASK_LOCK_TTL_HOURS=24
