<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="club.boyuan.official.persistence.mapper.RecruitmentCycleMapper">

    <sql id="cyclePhase">
        CASE WHEN DATE(UTC_TIMESTAMP()+INTERVAL 8 HOUR) &lt; start_date THEN 1
             WHEN DATE(UTC_TIMESTAMP()+INTERVAL 8 HOUR) &gt; end_date THEN 3 ELSE 2 END
    </sql>

    <resultMap id="RecruitmentCycleResultMap" type="club.boyuan.official.persistence.entity.RecruitmentCycle">
        <id property="cycleId" column="cycle_id"/>
        <result property="cycleName" column="cycle_name"/>
        <result property="description" column="description"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate" column="end_date"/>
        <result property="academicYear" column="academic_year"/>
        <result property="status" column="status"/>
        <result property="isActive" column="is_active"/>
        <result property="isDeleted" column="is_deleted"/>
        <!-- 自定义 resultMap 不继承实体上的 @TableField，新增列必须在这里补一行，
             否则接口查出来永远是 null（dept/is_member 就踩过这个坑） -->
        <result property="waitingRoom" column="waiting_room"/>
        <result property="onlineMeetingLink" column="online_meeting_link"/>
        <result property="rescheduleOpen" column="reschedule_open"/>
        <result property="contactInfo" column="contact_info"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 按 ID 点查刻意不过滤 is_deleted：历史简历详情、评价表都要按 ID 解析
         已删周期的名称。"已删除"只意味着从列表和开放周期里消失。 -->
    <select id="findById" parameterType="java.lang.Integer" resultMap="RecruitmentCycleResultMap">
        SELECT c.*, <include refid="cyclePhase"/> AS status FROM cycle_intake_config c
        WHERE cycle_id = #{cycleId}
    </select>

    <select id="findAll" resultMap="RecruitmentCycleResultMap">
        SELECT c.*, <include refid="cyclePhase"/> AS status FROM cycle_intake_config c
        WHERE is_deleted = 0
        ORDER BY created_at DESC
    </select>

    <select id="findByStatus" parameterType="java.lang.Integer" resultMap="RecruitmentCycleResultMap">
        SELECT c.*, <include refid="cyclePhase"/> AS status FROM cycle_intake_config c
        WHERE <choose><when test="status == 4">is_active = 0</when><otherwise><include refid="cyclePhase"/> = #{status}</otherwise></choose> AND is_deleted = 0
        ORDER BY created_at DESC
    </select>

    <select id="findByIsActive" parameterType="java.lang.Integer" resultMap="RecruitmentCycleResultMap">
        SELECT c.*, <include refid="cyclePhase"/> AS status FROM cycle_intake_config c
        WHERE is_active = #{isActive} AND is_deleted = 0
        ORDER BY created_at DESC
    </select>

    <select id="findByAcademicYear" parameterType="java.lang.String" resultMap="RecruitmentCycleResultMap">
        SELECT c.*, <include refid="cyclePhase"/> AS status FROM cycle_intake_config c
        WHERE academic_year = #{academicYear} AND is_deleted = 0
    </select>

    <!-- 软删除：单删与批删共用。同时关闭投递开关。
         这里没有硬删语句是刻意的 —— interview_session/interview_time_slot 对周期
         是 ON DELETE CASCADE，硬删会静默连带清掉整个周期的面试数据。 -->
    <update id="softDeleteByIds" parameterType="java.util.List">
        UPDATE cycle_intake_config
        SET is_deleted = 1, is_active = 0, updated_at = NOW()
        WHERE cycle_id IN
        <foreach collection="cycleIds" item="cycleId" open="(" separator="," close=")">
            #{cycleId}
        </foreach>
        AND is_deleted = 0
    </update>

    <select id="findAllWithPaginationAndSorting" resultMap="RecruitmentCycleResultMap">
        SELECT c.*, <include refid="cyclePhase"/> AS status FROM cycle_intake_config c
        WHERE is_deleted = 0
        ORDER BY
        <choose>
            <when test="sortBy != null and sortBy != ''">
                ${sortBy}
            </when>
            <otherwise>
                created_at
            </otherwise>
        </choose>
        <choose>
            <when test="sortOrder != null and sortOrder != ''">
                ${sortOrder}
            </when>
            <otherwise>
                DESC
            </otherwise>
        </choose>
        LIMIT #{offset}, #{limit}
    </select>

    <select id="findByConditions" resultMap="RecruitmentCycleResultMap">
        SELECT c.*, <include refid="cyclePhase"/> AS status FROM cycle_intake_config c
        <where>
            AND is_deleted = 0
            <if test="cycleName != null and cycleName != ''">
                AND cycle_name LIKE CONCAT('%', #{cycleName}, '%')
            </if>
            <if test="academicYear != null and academicYear != ''">
                AND academic_year = #{academicYear}
            </if>
            <if test="status != null">
                AND <choose><when test="status == 4">is_active = 0</when><otherwise><include refid="cyclePhase"/> = #{status}</otherwise></choose>
            </if>
            <if test="isActive != null">
                AND is_active = #{isActive}
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="sortBy != null and sortBy != ''">
                ${sortBy}
            </when>
            <otherwise>
                created_at
            </otherwise>
        </choose>
        <choose>
            <when test="sortOrder != null and sortOrder != ''">
                ${sortOrder}
            </when>
            <otherwise>
                DESC
            </otherwise>
        </choose>
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countByConditions" resultType="java.lang.Long">
        SELECT COUNT(*) FROM cycle_intake_config
        <where>
            AND is_deleted = 0
            <if test="cycleName != null and cycleName != ''">
                AND cycle_name LIKE CONCAT('%', #{cycleName}, '%')
            </if>
            <if test="academicYear != null and academicYear != ''">
                AND academic_year = #{academicYear}
            </if>
            <if test="status != null">
                AND <choose><when test="status == 4">is_active = 0</when><otherwise><include refid="cyclePhase"/> = #{status}</otherwise></choose>
            </if>
            <if test="isActive != null">
                AND is_active = #{isActive}
            </if>
        </where>
    </select>

    <!--
        「当前周期」= 今天落在起止日期内且未删除。不再按 is_active 过滤：
        管理员点「停止投递」（is_active=0）后周期在用户端要继续可见（看简历、看进度），
        只是不能再提交/修改/新建——那道闸在 ResumeServiceImpl.requireCycleOpen，
        本查询的结果里用 is_active 映射成 OpenCycleDTO.intakeOpen 交给前端区分。
        周期时间过了之后才从这里消失，没投过的同学自然看不到。
    -->
    <select id="findOpenForApplication" resultMap="RecruitmentCycleResultMap">
        SELECT c.*, <include refid="cyclePhase"/> AS status FROM cycle_intake_config c
        WHERE is_deleted = 0
          AND #{today} BETWEEN start_date AND end_date
        ORDER BY start_date DESC, cycle_id DESC
    </select>

    <select id="findUpcomingForApplication" resultMap="RecruitmentCycleResultMap">
        SELECT c.*, <include refid="cyclePhase"/> AS status FROM cycle_intake_config c
        WHERE is_active = 1
          AND is_deleted = 0
          AND start_date &gt; #{today}
        ORDER BY start_date ASC, cycle_id ASC
    </select>

</mapper>