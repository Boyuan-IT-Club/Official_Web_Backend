<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="club.boyuan.official.persistence.mapper.UserMapper">

    <!-- 结果映射 -->
    <resultMap id="UserResultMap" type="club.boyuan.official.persistence.entity.User">
        <id property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="email" column="email"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="role" column="role"/>
        <result property="major" column="major"/>
        <result property="github" column="github"/>
        <result property="deptId" column="dept_id"/>
        <!-- dept / is_member 此前漏映射：findByRoleAndDeptAndStatus 明明 SELECT 了这两列,
             但 resultMap 不认,MyBatis 直接丢弃 -> 接口 JSON 永远没有这两个键,
             管理端「部门」列因此恒显示非社员,批量录取/分配部门看不出任何变化。 -->
        <result property="dept" column="dept"/>
        <result property="isMember" column="is_member"/>
        <result property="avatar" column="avatar"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="isDeleted" column="is_deleted"/>
    </resultMap>

    <!-- 自定义查询方法 -->
    <select id="selectById" parameterType="java.lang.Integer" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE user_id = #{userId} AND is_deleted = 0
    </select>

    <select id="selectByUsername" parameterType="java.lang.String" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE username = #{username} AND is_deleted = 0
    </select>

    <select id="selectByEmail" parameterType="java.lang.String" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE email = #{email} AND is_deleted = 0
    </select>

    <select id="selectByPhone" parameterType="java.lang.String" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE phone = #{phone} AND is_deleted = 0
    </select>

    <update id="updateById" parameterType="club.boyuan.official.persistence.entity.User">
        UPDATE user
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="password != null">password = #{password},</if>
            <if test="email != null">email = #{email},</if>
            <if test="name != null">name = #{name},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="major != null">major = #{major},</if>
            <if test="github != null">github = #{github},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="status != null">status = #{status},</if>
            update_time = NOW()
        </set>
        WHERE user_id = #{userId}
    </update>

    <update id="updatePasswordById" parameterType="map">
        UPDATE user
        SET password = #{password}, update_time = NOW()
        WHERE user_id = #{userId}
    </update>

    <delete id="deleteById" parameterType="java.lang.Integer">
        UPDATE user SET is_deleted = 1, update_time = NOW()
        WHERE user_id = #{userId}
    </delete>

    <select id="selectAll" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE is_deleted = 0
    </select>

    <select id="findByRoleAndDeptAndStatus" resultMap="UserResultMap">
        SELECT user_id, username, password, email, role, name, phone, dept, avatar, create_time, status, is_member
        FROM user
        <where>
            AND is_deleted = 0
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
            <if test="dept != null and dept != ''">
                AND dept = #{dept}
            </if>
            <if test="status != null">
                AND status = #{status, jdbcType=BOOLEAN}
            </if>
        </where>
        LIMIT #{pageable.offset}, #{pageable.pageSize}
    </select>

    <select id="countByRoleAndDeptAndStatus" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM user
        <where>
            AND is_deleted = 0
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
            <if test="dept != null and dept != ''">
                AND dept = #{dept}
            </if>
            <if test="status != null">
                AND status = #{status, jdbcType=BOOLEAN}
            </if>
        </where>
    </select>
    
    <select id="searchUsers" parameterType="string" resultMap="UserResultMap">
        SELECT *
        FROM user 
        WHERE (username LIKE CONCAT('%', #{keyword}, '%') 
           OR name LIKE CONCAT('%', #{keyword}, '%') 
           OR email LIKE CONCAT('%', #{keyword}, '%') 
           OR phone LIKE CONCAT('%', #{keyword}, '%') 
           OR dept LIKE CONCAT('%', #{keyword}, '%'))
           AND is_deleted = 0
        LIMIT 20
    </select>
    
    <update id="batchUpdateStatusByIds">
        UPDATE user 
        SET status = #{status, jdbcType=BOOLEAN}, update_time = NOW()
        WHERE user_id IN
        <foreach collection="userIds" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
        AND is_deleted = 0
    </update>
    
    <update id="batchUpdateDeptByIds">
        UPDATE user 
        SET dept = #{dept}, update_time = NOW()
        WHERE user_id IN
        <foreach collection="userIds" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
        AND is_deleted = 0
    </update>
    
    <update id="batchUpdateMembershipByIds">
        UPDATE user 
        SET is_member = #{isMember, jdbcType=BOOLEAN}, update_time = NOW()
        WHERE user_id IN
        <foreach collection="userIds" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
        AND is_deleted = 0
    </update>
    
    <select id="selectByIds" resultMap="UserResultMap">
        SELECT *
        FROM user
        WHERE user_id IN
        <foreach collection="userIds" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
        AND is_deleted = 0
    </select>

    <!-- 统计卡:is_member 允许为 NULL(历史行),按「非社员」计,否则两数相加不等于总数 -->
    <select id="countByMembership" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM user
        WHERE is_deleted = 0
        <if test="isMember">
            AND is_member = 1
        </if>
        <if test="!isMember">
            AND (is_member = 0 OR is_member IS NULL)
        </if>
    </select>

    <select id="countFrozen" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM user
        WHERE is_deleted = 0
          AND status = 0
    </select>

</mapper>
