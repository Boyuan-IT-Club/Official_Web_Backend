<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="club.boyuan.official.persistence.mapper.ResumeFieldValueMapper">

    <resultMap id="ResumeFieldValueMap" type="club.boyuan.official.persistence.entity.ResumeFieldValue">
        <id column="value_id" property="valueId"/>
        <result column="resume_id" property="resumeId"/>
        <result column="field_id" property="fieldId"/>
        <result column="field_value" property="fieldValue"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 自定义查询方法 -->
    <select id="findByResumeId" parameterType="java.lang.Integer" resultMap="ResumeFieldValueMap">
        SELECT * FROM resume_field_value
        WHERE resume_id = #{resumeId}
    </select>

    <!-- 批量版：列表页用一次 IN 查询替掉「每份简历一次」的 N+1 -->
    <select id="findByResumeIds" resultMap="ResumeFieldValueMap">
        SELECT * FROM resume_field_value
        WHERE resume_id IN
        <foreach collection="resumeIds" item="rid" open="(" separator="," close=")">
            #{rid}
        </foreach>
    </select>

    <select id="findByResumeIdAndFieldId" resultMap="ResumeFieldValueMap">
        SELECT * FROM resume_field_value
        WHERE resume_id = #{resumeId} AND field_id = #{fieldId}
    </select>

    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO resume_field_value (resume_id, field_id, field_value, created_at, updated_at)
        VALUES
        <foreach collection="fieldValues" item="item" separator=",">
            (#{item.resumeId}, #{item.fieldId}, #{item.fieldValue}, NOW(), NOW())
        </foreach>
    </insert>

    <update id="update" parameterType="club.boyuan.official.persistence.entity.ResumeFieldValue">
        UPDATE resume_field_value
        <set>
            <if test="fieldValue != null">field_value = #{fieldValue},</if>
            <if test="fieldValue != null">updated_at = NOW(),</if>
        </set>
        WHERE value_id = #{valueId}
    </update>

    <!-- 批量更新：单条 CASE WHEN 语句实现。
         注意不要用 foreach separator=";" 拼多条 UPDATE——JDBC 默认禁止多语句，
         会抛 SQLSyntaxErrorException（历史上因该方法从未被触发而长期潜伏）。 -->
    <update id="batchUpdate" parameterType="java.util.List">
        UPDATE resume_field_value
        SET field_value = CASE value_id
        <foreach collection="fieldValues" item="item">
            <if test="item.fieldValue != null">WHEN #{item.valueId} THEN #{item.fieldValue}</if>
        </foreach>
            ELSE field_value
        END,
        updated_at = NOW()
        WHERE value_id IN
        <foreach collection="fieldValues" item="item" open="(" separator="," close=")">
            #{item.valueId}
        </foreach>
    </update>

    <delete id="deleteByResumeId" parameterType="java.lang.Integer">
        DELETE FROM resume_field_value
        WHERE resume_id = #{resumeId}
    </delete>

    <delete id="deleteByFieldId" parameterType="java.lang.Integer">
        DELETE FROM resume_field_value
        WHERE field_id = #{fieldId}
    </delete>

</mapper>