# 协同评价服务配置。实际值填在 00-9 配置清单里，不要提交到仓库。

COLLAB_PORT=3100

# 与 Java 后端同一把 JWT 密钥（HS256），用于校验浏览器带来的令牌
JWT_SECRET=

# 调用 Java /api/internal/** 的服务令牌，需与后端 COLLAB_SERVICE_TOKEN 一致
COLLAB_SERVICE_TOKEN=

# Java 后端地址（容器网络内可用服务名）
BACKEND_BASE_URL=http://official-backend:8080

DB_HOST=official-mysql
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=official
DB_POOL_SIZE=5

# 快照落库防抖（毫秒）
STORE_DEBOUNCE_MS=2000
# 物化回写业务库的防抖（毫秒）
MATERIALIZE_DEBOUNCE_MS=30000
# 名单对账周期（毫秒）
RECONCILE_INTERVAL_MS=300000
